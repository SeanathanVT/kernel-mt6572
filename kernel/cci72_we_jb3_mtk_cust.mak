# MTK global compile-time defines for the cci72_we_jb3 kernel build.
#
# kernel/Makefile does '-include $(MTK_PROJECT)_mtk_cust.mak' to pull in
# the -D flags from ProjectConfig.mk's AUTO_ADD_GLOBAL_DEFINE_BY_{NAME,VALUE}
# lists. In a full MTK/Android build this file is produced by codegen; the
# standalone GPL kernel build has no codegen, so it is checked in here.
# Without it, MTK_*-gated code (e.g. MTK_BQ24196_SUPPORT in usb20.c) silently
# takes the wrong branch. Regenerate from ProjectConfig.mk if those lists change.
#
# BY_VALUE entries with multi-word values (e.g. CUSTOM_KERNEL_LENS,
# CUSTOM_KERNEL_IMGSENSOR) are camera/lens build selectors, not C defines;
# emitting them as -DNAME=a b word-splits and breaks gcc, so they are skipped.

MTK_GLOBAL_DEFINES := -DCUSTOM_KERNEL_ACCELEROMETER -DCUSTOM_KERNEL_ALSPS -DCUSTOM_KERNEL_GYROSCOPE -DCUSTOM_KERNEL_MAGNETOMETER -DCUSTOM_KERNEL_MAIN2_IMGSENSOR -DCUSTOM_KERNEL_OFN -DCUSTOM_KERNEL_SSW -DEMMC_CHIP -DENCRY_PARTITION_SUPPORT -DEVDO_DT_SUPPORT -DEVDO_DT_VIA_SUPPORT -DHAVE_AACENCODE_FEATURE -DHAVE_ADPCMENCODE_FEATURE -DHAVE_AWBENCODE_FEATURE -DHAVE_CMMB_FEATURE -DHAVE_XLOG_FEATURE -DLCM_HEIGHT -DLCM_WIDTH -DMODEM_UMTS_TDD128_MODE -DMTK_2IN1_SPK_SUPPORT -DMTK_2SDCARD_SWAP -DMTK_AAL_SUPPORT -DMTK_ACMT_DEBUG -DMTK_ASF_PLAYBACK_SUPPORT -DMTK_AUDIO_ADPCM_SUPPORT -DMTK_AUDIO_RAW_SUPPORT -DMTK_AUD_LOCK_MD_SLEEP_SUPPORT -DMTK_AUTORAMA_SUPPORT -DMTK_AUTO_DETECT_ACCELEROMETER -DMTK_AUTO_DETECT_MAGNETOMETER -DMTK_BEAM_PLUS_SUPPORT -DMTK_BICR_SUPPORT -DMTK_BIP_SCWS -DMTK_BQ24196_SUPPORT -DMTK_BQ27541_SUPPORT -DMTK_BRAZIL_CUSTOMIZATION -DMTK_BRAZIL_CUSTOMIZATION_CLARO -DMTK_BRAZIL_CUSTOMIZATION_VIVO -DMTK_BSP_PACKAGE -DMTK_BT_21_SUPPORT -DMTK_BT_30_SUPPORT -DMTK_BT_40_SUPPORT -DMTK_BT_FM_OVER_BT_VIA_CONTROLLER -DMTK_BT_PROFILE_A2DP -DMTK_BT_PROFILE_AVRCP -DMTK_BT_PROFILE_AVRCP14 -DMTK_BT_PROFILE_BIP -DMTK_BT_PROFILE_BPP -DMTK_BT_PROFILE_DUN -DMTK_BT_PROFILE_FTP -DMTK_BT_PROFILE_HFP -DMTK_BT_PROFILE_HIDH -DMTK_BT_PROFILE_MANAGER -DMTK_BT_PROFILE_MAPC -DMTK_BT_PROFILE_MAPS -DMTK_BT_PROFILE_OPP -DMTK_BT_PROFILE_PAN -DMTK_BT_PROFILE_PBAP -DMTK_BT_PROFILE_PRXM -DMTK_BT_PROFILE_PRXR -DMTK_BT_PROFILE_SIMAP -DMTK_BT_PROFILE_SPP -DMTK_BT_PROFILE_TIMEC -DMTK_BT_PROFILE_TIMES -DMTK_BT_SUPPORT -DMTK_CACHE_MERGE_SUPPORT -DMTK_CAMCORDER_PROFILE_MID_MP4 -DMTK_CAMERA_APP_3DHW_SUPPORT -DMTK_CAMERA_BSP_SUPPORT -DMTK_COMBO_CORE_DUMP_SUPPORT -DMTK_COMBO_QUICK_SLEEP_SUPPORT -DMTK_COMBO_SUPPORT -DMTK_CTPPPOE_SUPPORT -DMTK_DDR3_SUPPORT -DMTK_DEDICATEDAPN_SUPPORT -DMTK_DHCPV6C_WIFI -DMTK_DISABLE_POWER_ON_OFF_VOLTAGE_LIMITATION -DMTK_DISPLAY_HIGH_RESOLUTION -DMTK_DSPIRDBG -DMTK_DT_SUPPORT -DMTK_DUAL_MIC_SUPPORT -DMTK_EAP_SIM_AKA -DMTK_EMMC_DISCARD -DMTK_EMMC_SUPPORT -DMTK_EMMC_SUPPORT_OTP -DMTK_EMULATOR_SUPPORT -DMTK_ENABLE_MD1 -DMTK_ENABLE_MD2 -DMTK_ENABLE_VIDEO_EDITOR -DMTK_EXTERNAL_MODEM_SLOT -DMTK_FACEBEAUTY_SUPPORT -DMTK_FAN5405_SUPPORT -DMTK_FAT_ON_NAND -DMTK_FD_SUPPORT -DMTK_FLIGHT_MODE_POWER_OFF_MD -DMTK_FM_50KHZ_SUPPORT -DMTK_FM_RECORDING_SUPPORT -DMTK_FM_RX_SUPPORT -DMTK_FM_SHORT_ANTENNA_SUPPORT -DMTK_FM_SUPPORT -DMTK_FM_TX_SUPPORT -DMTK_FSCK_MSDOS_MTK -DMTK_GEMINI_3SIM_SUPPORT -DMTK_GEMINI_4SIM_SUPPORT -DMTK_GPS_SUPPORT -DMTK_HDMI_SUPPORT -DMTK_HDR_SUPPORT -DMTK_HIGH_QUALITY_THUMBNAIL -DMTK_HW_ENHANCE -DMTK_IMAGE_LARGE_MEM_LIMIT -DMTK_ION_SUPPORT -DMTK_IPOH_SUPPORT -DMTK_IPV6_SUPPORT -DMTK_IPV6_TETHER_NDP_MODE -DMTK_IPV6_TETHER_PD_MODE -DMTK_KERNEL_POWER_OFF_CHARGING -DMTK_LCA_RAM_OPTIMIZE -DMTK_LCA_ROM_OPTIMIZE -DMTK_LCA_SUPPORT -DMTK_LCEEFT_SUPPORT -DMTK_LCM_PHYSICAL_ROTATION -DMTK_M4U_SUPPORT -DMTK_MASS_STORAGE -DMTK_MATV_ANALOG_SUPPORT -DMTK_MATV_SERIAL_IF_SUPPORT -DMTK_MAV_SUPPORT -DMTK_MDM_FUMO -DMTK_MDM_LAWMO -DMTK_MDM_SCOMO -DMTK_MD_SHUT_DOWN_NT -DMTK_MEM_PRESERVED_MODE_ENABLE -DMTK_MERGE_INTERFACE_SUPPORT -DMTK_MMPROFILE_SUPPORT -DMTK_MT6572V1_PHONE_POWER_REWORK -DMTK_MT8193_HDCP_SUPPORT -DMTK_MT8193_HDMI_SUPPORT -DMTK_MT8193_NFI_SUPPORT -DMTK_MT8193_SUPPORT -DMTK_MULTIBRIDGE_SUPPORT -DMTK_MULTISIM_RINGTONE_SUPPORT -DMTK_MULTI_STORAGE_SUPPORT -DMTK_NAND_UBIFS_SUPPORT -DMTK_NATIVE_3D_SUPPORT -DMTK_NCP1851_SUPPORT -DMTK_NEON_SUPPORT -DMTK_NFC_SUPPORT -DMTK_NVRAM_SECURITY -DMTK_PLATFORM_OPTIMIZE -DMTK_PQ_SUPPORT -DMTK_PRODUCT_INFO_SUPPORT -DMTK_QVGA_LANDSCAPE_SUPPORT -DMTK_RADIOOFF_POWER_OFF_MD -DMTK_RILD_READ_IMSI -DMTK_RMVB_PLAYBACK_SUPPORT -DMTK_S3D_SUPPORT -DMTK_SD_REINIT_SUPPORT -DMTK_SENSOR_SUPPORT -DMTK_SHARED_SDCARD -DMTK_SHARE_MODEM_CURRENT -DMTK_SHARE_MODEM_SUPPORT -DMTK_SIM1_SOCKET_TYPE -DMTK_SIM2_SOCKET_TYPE -DMTK_SIM_AUTHENTICATION_SUPPORT -DMTK_SINGLE_3DSHOT_SUPPORT -DMTK_SPH_EHN_CTRL_SUPPORT -DMTK_STEREO3D_WALLPAPER_APP -DMTK_TABLET_DRAM -DMTK_TABLET_PLATFORM -DMTK_TB_APP_CALL_FORCE_SPEAKER_ON -DMTK_TB_DEBUG_SUPPORT -DMTK_TB_HW_DEBUG -DMTK_TETHERINGIPV6_SUPPORT -DMTK_TETHERING_EEM_SUPPORT -DMTK_THEMEMANAGER_APP -DMTK_TMP103_SUPPORT -DMTK_TOUCH_PHYSICAL_ROTATION_RELATIVE_TO_LCM -DMTK_TVOUT_SUPPORT -DMTK_UART_USB_SWITCH -DMTK_UMTS_TDD128_MODE -DMTK_USES_HD_VIDEO -DMTK_USES_VR_DYNAMIC_QUALITY_MECHANISM -DMTK_VOICE_UI_SUPPORT -DMTK_VOICE_UNLOCK_SUPPORT -DMTK_VT3G324M_SUPPORT -DMTK_WAPI_SUPPORT -DMTK_WB_SPEECH_SUPPORT -DMTK_WEB_NOTIFICATION_SUPPORT -DMTK_WFD_SUPPORT -DMTK_WIFI_HOTSPOT_SUPPORT -DMTK_WLANBT_SINGLEANT -DMTK_WLAN_SUPPORT -DMTK_YAML_SCATTER_FILE_SUPPORT -DMTK_YMAL_SCATTER_FILE_SUPPORT -DNAND_OTP_SUPPORT -DTELEPHONY_DFOSET -DMTK_PLATFORM=MT6572 -DBOOT_LOGO=wvga -DCUSTOM_KERNEL_LCM=nt35510_dsi_cmd_6572 -DMTK_MODEM_SUPPORT=modem_3g -DMTK_ATV_CHIP=MTK_MT5193 -DCUSTOM_KERNEL_MAIN_IMGSENSOR=s5k4ecgx_mipi_yuv -DMTK_BT_CHIP=MTK_CONSYS_MT6572 -DMTK_IME_INPUT_ENGINE=none -DCUSTOM_KERNEL_FLASHLIGHT=dummy_flashlight -DCUSTOM_KERNEL_SUB_IMGSENSOR=s5k8aayx_yuv -DCUSTOM_KERNEL_SUB_LENS=dummy_lens -DMTK_AUDIO_BLOUD_CUSTOMPARAMETER_REV=MTK_AUDIO_BLOUD_CUSTOMPARAMETER_V4 -DMTK_FM_RX_AUDIO=FM_DIGITAL_INPUT -DMTK_COMBO_CHIP=MT6572_CONSYS -DMTK_GPS_CHIP=MTK_GPS_MT6572 -DCUSTOM_KERNEL_MAIN_LENS=sensordrive -DMTK_FM_TX_AUDIO=FM_ANALOG_OUTPUT -DMTK_FM_CHIP=MT6627_FM -DMTK_IME_HANDWRITING_ENGINE=none

MTK_CDEFS   += $(MTK_GLOBAL_DEFINES)
MTK_CPPDEFS += $(MTK_GLOBAL_DEFINES)
MTK_ADEFS   += $(MTK_GLOBAL_DEFINES)
